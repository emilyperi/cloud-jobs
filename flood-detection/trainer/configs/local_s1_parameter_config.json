{
  "optimizer": {
    "module": "keras.optimizers.legacy",
    "class_name": "Adam",
    "config": {
      "name": "Adam",
      "learning_rate": {
        "module": "keras.optimizers.schedules",
        "class_name": "CosineDecay",
        "config": {
          "initial_learning_rate": 0,
          "decay_steps": 190,
          "alpha": 0.0,
          "name": null,
          "warmup_target": 0.001,
          "warmup_steps": 740
        },
        "registered_name": null
      },
      "decay": 0.0,
      "beta_1": 0.9,
      "beta_2": 0.999,
      "epsilon": 1e-07,
      "amsgrad": false
    },
    "registered_name": null
  },
  "loss": {
    "class_name": "BinaryCrossentropy",
    "config": {
      "reduction": "auto",
      "name": "binary_crossentropy",
      "from_logits": true,
      "label_smoothing": 0.0,
      "axis": -1
    }
  },
  "metrics": [
    {
      "class_name": "BinaryAccuracy",
      "config": {
        "name": "binary_accuracy",
        "dtype": "float32",
        "threshold": 0.5
      }
    }
  ],
  "batch_size": 32,
  "epochs": 400,
  "k": 5,
  "train_size": 2368
}
